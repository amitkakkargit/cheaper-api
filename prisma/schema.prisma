generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(uuid())
  email          String?         @unique
  phone          String?         @unique
  name           String?
  avatarUrl      String?
  createdAt      DateTime        @default(now())
  otpCodes       OtpCode[]
  sellers        Seller[]
  purchases      Purchase[]
  sellerReviews  SellerReview[]
  productReviews ProductReview[]
  buyerReviewsWritten BuyerReview[] @relation("BuyerReviewReviewer")
  buyerReviewsReceived BuyerReview[] @relation("BuyerReviewBuyer")
  supportTickets SupportTicket[]
}

model OtpCode {
  id        String    @id @default(uuid())
  channel   String
  target    String
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User?     @relation(fields: [userId], references: [id])
  userId    String?

  @@index([target, channel])
}

model Seller {
  id        String         @id @default(uuid())
  userId    String
  name      String
  location  String         @default("")
  bio       String         @default("")
  avatarUrl String         @default("")
  latitude  Float
  longitude Float
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id])
  products  Product[]
  reviews   SellerReview[]

  @@index([userId])
}

model Product {
  id                 String          @id @default(uuid())
  sellerId           String
  name               String
  title              String
  description        String          @default("")
  imageUrl           String          @default("")
  images             String[]        @default([])
  videoUrl           String          @default("")
  videoStory         String          @default("")
  currentPrice       Float           @default(0)
  previousPrice      Float           @default(0)
  discountPercentage Int             @default(0)
  condition          String          @default("Used")
  location           String          @default("")
  category           String          @default("Miscellaneous")
  latitude           Float
  longitude          Float
  createdAt          DateTime        @default(now())
  sellerMarkedSoldAt DateTime?
  seller             Seller          @relation(fields: [sellerId], references: [id])
  purchases          Purchase[]
  reviews            ProductReview[]
  buyerReviews       BuyerReview[]
  supportTickets     SupportTicket[]

  @@index([sellerId])
}

model Purchase {
  id                String    @id @default(uuid())
  productId         String
  buyerId           String
  sellerId          String
  buyerConfirmedAt  DateTime?
  sellerConfirmedAt DateTime?
  createdAt         DateTime  @default(now())
  product           Product   @relation(fields: [productId], references: [id])
  buyer             User      @relation(fields: [buyerId], references: [id])

  @@unique([productId, buyerId])
  @@index([productId])
  @@index([buyerId])
  @@index([sellerId])
}

model SellerReview {
  id        String   @id @default(uuid())
  userId    String
  sellerId  String
  productId String?
  rating    Float
  comment   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  seller    Seller   @relation(fields: [sellerId], references: [id])

  @@unique([userId, sellerId])
  @@index([sellerId])
}

model ProductReview {
  id        String   @id @default(uuid())
  userId    String
  productId String
  sellerId  String?
  rating    Float
  comment   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@index([productId])
}

model BuyerReview {
  id         String   @id @default(uuid())
  reviewerId String
  buyerId    String
  productId  String
  rating     Float
  comment    String?
  createdAt  DateTime @default(now())
  reviewer   User     @relation("BuyerReviewReviewer", fields: [reviewerId], references: [id])
  buyer      User     @relation("BuyerReviewBuyer", fields: [buyerId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])

  @@unique([reviewerId, buyerId, productId])
  @@index([buyerId])
  @@index([productId])
}

model SupportTicket {
  id            String   @id @default(uuid())
  subject       String
  description   String
  category      String
  email         String?
  source        String
  deviceInfo    String?
  appVersion    String?
  screenshotUrl String?
  productId     String?
  userId        String?
  status        String   @default("OPEN")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User?    @relation(fields: [userId], references: [id])
  product       Product? @relation(fields: [productId], references: [id])

  @@index([userId])
  @@index([productId])
  @@index([email])
  @@index([createdAt])
}
